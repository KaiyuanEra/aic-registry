services:
  {app-name}:
    image: ${PROGRAM:-{full-image-name}}:${VERSION:-{x.y.z}}
    container_name: {app-name}
    restart: unless-stopped
    hostname: ${HOSTNAME}

    volumes:
      # Persistent data directory (auto-copied from image on first start)
      - {app-name}-data:/app/data
      # Log mount point (adjust path as needed)
      - /data/logs:/app/data/logs
      # Timezone sync: mount localtime only; TZ is injected via env var (/etc/timezone may not exist or be a file on some systems, mounting it causes errors)
      - /etc/localtime:/etc/localtime:ro

    environment:
      - ENV=${ENV:-prod}
      - TZ=Asia/Shanghai
      # Sensitive vars injected via .env file or external source; never hardcoded here

    ports:
      - "{host-port}:{container-port}"

    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:{port}/health >/dev/null 2>&1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "5"

    deploy:
      resources:
        limits:
          cpus: '{cpu-limit}'
          memory: {memory-limit}
        reservations:
          cpus: '0.5'
          memory: 1G

volumes:
  {app-name}-data:
    driver: local
