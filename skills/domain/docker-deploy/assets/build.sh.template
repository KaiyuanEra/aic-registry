#!/bin/bash
# Build script - builds and pushes image based on env.sh configuration
# Usage: ./docker/build.sh [--push] [--no-cache] [--platform linux/amd64]

set -e
cd "$(dirname "$0")"
source ./env.sh

# ---- Argument parsing ----
PLATFORM="linux/amd64"
PUSH=false
NO_CACHE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --platform) PLATFORM="$2"; shift 2 ;;
        --push)     PUSH=true; shift ;;
        --no-cache) NO_CACHE=true; shift ;;
        *) echo "Unknown argument: $1"; echo "Usage: $0 [--platform] [--push] [--no-cache]"; exit 1 ;;
    esac
done

# ---- Build info ----
echo "================================================"
echo "  Image:  $PROGRAM:$VERSION"
echo "  Platform: $PLATFORM"
echo "  Push:   $PUSH"
echo "================================================"

cd ..  # Switch to project root as build context

# ---- Build ----
BUILD_CMD="docker build --platform $PLATFORM"
BUILD_CMD="$BUILD_CMD -t $PROGRAM:$VERSION"
BUILD_CMD="$BUILD_CMD -t $PROGRAM:latest"
BUILD_CMD="$BUILD_CMD --build-arg VERSION=$VERSION"
BUILD_CMD="$BUILD_CMD --build-arg ENV=$ENV"
BUILD_CMD="$BUILD_CMD --build-arg GOPROXY=$GOPROXY"
BUILD_CMD="$BUILD_CMD --build-arg APT_MIRROR=$APT_MIRROR"
[ "$NO_CACHE" = true ] && BUILD_CMD="$BUILD_CMD --no-cache"
BUILD_CMD="$BUILD_CMD -f docker/Dockerfile ."

eval $BUILD_CMD

# ---- Push ----
if [ "$PUSH" = true ]; then
    echo "Pushing image to registry..."
    docker push "$PROGRAM:$VERSION"
    docker push "$PROGRAM:latest"
    echo "Push complete"
fi

echo "================================================"
echo "  Done:   $PROGRAM:$VERSION"
echo "  Local:  cd docker && docker-compose up -d"
echo "  Push:   ./docker/build.sh --push"
echo "================================================"
