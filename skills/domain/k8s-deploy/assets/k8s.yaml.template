# ============================================================
# {App Name} K8s full deployment config
# Version: {version} | Generated: {timestamp}
# Purpose: Use for initial deployment or environment rebuild
# Command: kubectl apply -f docker/k8s.yaml
# ============================================================

# ---- ConfigMap: application config file ----
apiVersion: v1
kind: ConfigMap
metadata:
  name: {app-name}-cfg
  namespace: {namespace}
  labels:
    app: {app-name}
    version: "{version}"
data:
  key-{config-filename}: |-
    # Paste application config file content here
    {config-content}

---
# ---- Secret: sensitive config (values must be base64-encoded manually) ----
# Generate base64: echo -n "your-value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: {secret-name}
  namespace: {namespace}
type: Opaque
data:
  {key}: {base64-value}   # Replace with actual base64-encoded value

---
# ---- Deployment: application deployment ----
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {app-name}
  namespace: {namespace}
  labels:
    app: {app-name}
    version: "{version}"
spec:
  replicas: {replicas}
  selector:
    matchLabels:
      app: {app-name}
  template:
    metadata:
      labels:
        app: {app-name}
        version: "{version}"
    spec:
      containers:
        - name: {app-name}
          image: {registry}/{namespace}/{image-name}:{version}
          imagePullPolicy: Always
          ports:
            - name: http
              protocol: TCP
              containerPort: {port}
          env:
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: {secret-name}
                  key: {secret-key}
            - name: ENV
              value: "{env}"
          resources:
            limits:
              cpu: "{cpu-limit}"
              memory: "{memory-limit}"
            requests:
              cpu: "{cpu-request}"
              memory: "{memory-request}"
          volumeMounts:
            - name: config-volume
              mountPath: /opt/{app-name}/config
            - name: tz-config
              mountPath: /etc/localtime
          livenessProbe:
            httpGet:
              path: /health
              port: {port}
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /health
              port: {port}
            initialDelaySeconds: 15
            periodSeconds: 5
      volumes:
        - name: config-volume
          configMap:
            name: {app-name}-cfg
            items:
              - key: key-{config-filename}
                path: {config-filename}
        - name: tz-config
          hostPath:
            path: /etc/localtime

---
# ---- Service: service exposure ----
apiVersion: v1
kind: Service
metadata:
  name: {app-name}-svc
  namespace: {namespace}
  labels:
    app: {app-name}
spec:
  selector:
    app: {app-name}
  clusterIP: None   # Headless Service, suitable for single-instance or stateful services
  ports:
    - port: {port}
      name: http

---
# ---- Ingress: external access routing ----
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {app-name}-ingress
  namespace: {namespace}
  annotations:
    kubernetes.io/ingress.class: 'nginx'
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  rules:
    - host: {subdomain}.{domain}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {app-name}-svc
                port:
                  number: {port}
