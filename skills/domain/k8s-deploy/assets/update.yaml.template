# ============================================================
# {App Name} K8s incremental update config
# Version: {version} | Generated: {timestamp}
# Purpose: Update image version only; does not affect ConfigMap / Service / Ingress / Secret
# Command: kubectl apply -f docker/update.yaml
# Note: This file contains only the Deployment to avoid overwriting other existing resource configs
# ============================================================

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {app-name}
  namespace: {namespace}
spec:
  replicas: {replicas}
  selector:
    matchLabels:
      app: {app-name}
  template:
    metadata:
      labels:
        app: {app-name}
        version: "{version}"     # Version label updated in sync
    spec:
      containers:
        - name: {app-name}
          image: {registry}/{namespace}/{image-name}:{version}   # The only field that needs updating
          imagePullPolicy: Always
          ports:
            - name: http
              protocol: TCP
              containerPort: {port}
          env:
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: {secret-name}
                  key: {secret-key}
            - name: ENV
              value: "{env}"
          resources:
            limits:
              cpu: "{cpu-limit}"
              memory: "{memory-limit}"
            requests:
              cpu: "{cpu-request}"
              memory: "{memory-request}"
          volumeMounts:
            - name: config-volume
              mountPath: /opt/{app-name}/config
            - name: tz-config
              mountPath: /etc/localtime
          livenessProbe:
            httpGet:
              path: /health
              port: {port}
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /health
              port: {port}
            initialDelaySeconds: 15
            periodSeconds: 5
      volumes:
        - name: config-volume
          configMap:
            name: {app-name}-cfg
            items:
              - key: key-{config-filename}
                path: {config-filename}
        - name: tz-config
          hostPath:
            path: /etc/localtime
