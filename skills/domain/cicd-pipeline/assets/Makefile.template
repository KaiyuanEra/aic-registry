# ============================================================
# {App Name} 构建命令
# 使用说明：make <target>
# ============================================================

# ---- 变量定义（与 docker/env.sh 保持同步）----
# 注意：Makefile 中不直接 source shell 脚本
# 变量在此处显式定义，与 docker/env.sh 保持同步
PROGRAM     ?= {registry}/{namespace}/{image-name}
VERSION     ?= {x.y.z}
ENV         ?= prod
PLATFORM    ?= linux/amd64

# ============================================================
# 帮助命令（默认目标）
# ============================================================
.PHONY: help
help:                          ## 显示所有可用命令
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
	awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

# ============================================================
# Docker 构建命令
# ============================================================
.PHONY: build
build:                         ## 构建 Docker 镜像（不推送）
	@cd docker && ./build.sh

.PHONY: build-push
build-push:                    ## 构建并推送 Docker 镜像到仓库
	@cd docker && ./build.sh --push

.PHONY: build-no-cache
build-no-cache:                ## 无缓存构建 Docker 镜像
	@cd docker && ./build.sh --no-cache

.PHONY: build-arm
build-arm:                     ## 构建 ARM64 镜像
	@cd docker && ./build.sh --platform linux/arm64

# ============================================================
# 本地运行命令
# ============================================================
.PHONY: up
up:                            ## 启动本地容器服务
	@cd docker && docker-compose up -d
	@echo "服务已启动，查看日志：make logs"

.PHONY: down
down:                          ## 停止本地容器服务
	@cd docker && docker-compose down

.PHONY: restart
restart:                       ## 重启本地容器服务
	@cd docker && docker-compose restart

.PHONY: logs
logs:                          ## 查看容器日志（实时）
	@cd docker && docker-compose logs -f

.PHONY: ps
ps:                            ## 查看容器状态
	@cd docker && docker-compose ps

# ============================================================
# 版本管理命令
# ============================================================
.PHONY: version
version:                       ## 显示当前版本信息
	@echo "程序: $(PROGRAM)"
	@echo "版本: $(VERSION)"
	@echo "环境: $(ENV)"

.PHONY: tag
tag:                           ## 为当前提交打版本 Tag（git tag）
	@git tag -a v$(VERSION) -m "Release v$(VERSION)"
	@echo "已创建 Tag: v$(VERSION)"
	@echo "推送 Tag：git push origin v$(VERSION)"
