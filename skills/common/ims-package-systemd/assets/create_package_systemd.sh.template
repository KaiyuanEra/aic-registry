#!/bin/bash
# create_package_systemd.sh - 生成边缘下发应用安装包（systemd 模式）
# 编码: UTF-8
# 生成自 ims-package-systemd skill，{{APP_NAME}} 已替换为实际应用名

set -e

# ============================================================================
# 参数读取
# ============================================================================
APP_NAME="${APP_NAME:-{{APP_NAME}}}"
VERSION="${VERSION:-dev}"
ENV="${ENV:-prod}"
OUTPUT_DIR="${OUTPUT_DIR:-dist/packages}"

# ============================================================================
# 常量定义
# ============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PACKAGE_NAME="${APP_NAME}-${VERSION}"

[[ "$OUTPUT_DIR" != /* ]] && OUTPUT_DIR="${PROJECT_ROOT}/${OUTPUT_DIR}"

TEMP_DIR="${OUTPUT_DIR}/.tmp/${PACKAGE_NAME}"
FINAL_DIR="${OUTPUT_DIR}/${VERSION}"
BINARY_SRC="${PROJECT_ROOT}/bin/${APP_NAME}-linux-amd64"
SERVICE_SRC="${PROJECT_ROOT}/config/${APP_NAME}.service"

# ============================================================================
# 函数定义
# ============================================================================
log_info()  { echo "✅ $1"; }
log_error() { echo "❌ 错误: $1" >&2; }
log_step()  { echo ""; echo "===================================="; echo "  $1"; echo "===================================="; }

validate_utf8_file() {
    local file="$1"
    if command -v python3 > /dev/null 2>&1; then
        python3 - "$file" > /dev/null 2>&1 <<'PY'
from pathlib import Path
import sys
Path(sys.argv[1]).read_bytes().decode("utf-8")
PY
        return $?
    fi
    command -v iconv > /dev/null 2>&1 && { iconv -f UTF-8 -t UTF-8 "$file" > /dev/null 2>&1; return $?; }
    command -v file > /dev/null 2>&1 && { file -I "$file" 2>/dev/null | grep -Eq 'charset=(utf-8|us-ascii)$'; return $?; }
    return 0
}

show_encoding_diagnostics() {
    local file="$1"
    command -v file > /dev/null 2>&1 && echo "   file -I: $(file -I "$file" 2>/dev/null)" >&2
    command -v iconv > /dev/null 2>&1 && { iconv -f UTF-8 -t UTF-8 "$file" > /dev/null 2>&1; echo "   iconv exit: $?" >&2; }
}

cleanup() { [ -d "$TEMP_DIR" ] && rm -rf "$TEMP_DIR"; }

preserve_unpacked() {
    if [ -d "$TEMP_DIR" ]; then
        [ -d "$FINAL_DIR" ] && rm -rf "$FINAL_DIR"
        mv "$TEMP_DIR" "$FINAL_DIR"
        log_info "未压缩内容已保留: $FINAL_DIR"
    fi
}

# ============================================================================
# Step 0：编译检查
# ============================================================================
log_step "0. 编译检查"
if [ ! -f "$BINARY_SRC" ]; then
    log_error "Linux amd64 binary 不存在: $BINARY_SRC"
    echo "请先执行: make build-linux"
    exit 1
fi
log_info "Binary: $BINARY_SRC"

# ============================================================================
# Step 1：环境检查
# ============================================================================
log_step "1. 环境检查"
[ -f "$SERVICE_SRC" ] || { log_error "systemd unit 文件不存在: $SERVICE_SRC"; exit 1; }
log_info "Unit 文件: $SERVICE_SRC"
mkdir -p "$OUTPUT_DIR"
cleanup

# ============================================================================
# Step 2：创建目录结构
# ============================================================================
log_step "2. 创建目录结构"
mkdir -p "$TEMP_DIR/scripts" "$TEMP_DIR/bin" "$TEMP_DIR/config"
log_info "临时目录: $TEMP_DIR"

# ============================================================================
# Step 3：生成 app.yaml
# ============================================================================
log_step "3. 生成 app.yaml"
cat > "$TEMP_DIR/app.yaml" <<'EOF'
name: {{APP_NAME}}
version: "__VERSION__"
description: {{APP_DESCRIPTION}}

ports:
  - {{HEALTH_PORT}}

health_check:
  type: http
  urls:
    - http://127.0.0.1:{{HEALTH_PORT}}/health
  strategy: any
  timeout: 3000
EOF
sed -i.bak "s/__VERSION__/$VERSION/g" "$TEMP_DIR/app.yaml" && rm -f "$TEMP_DIR/app.yaml.bak"
log_info "app.yaml 已生成"

# ============================================================================
# Step 4：复制 binary
# ============================================================================
log_step "4. 复制 binary"
cp "$BINARY_SRC" "$TEMP_DIR/bin/{{APP_NAME}}"
chmod +x "$TEMP_DIR/bin/{{APP_NAME}}"
log_info "binary 已复制: bin/{{APP_NAME}}"

# ============================================================================
# Step 5：复制 systemd unit 文件
# ============================================================================
log_step "5. 复制 systemd unit 文件"
cp "$SERVICE_SRC" "$TEMP_DIR/config/{{APP_NAME}}.service"
log_info "unit 文件已复制: config/{{APP_NAME}}.service"

# ============================================================================
# Step 6：生成 install.sh
# ============================================================================
log_step "6. 生成 install.sh"

cat > "$TEMP_DIR/scripts/install.sh" <<'INSTALL_EOF'
#!/bin/bash
# install.sh - {{APP_NAME}} systemd 升级脚本
# 编码: UTF-8
set -e

VERSION_DIR="${VERSION_DIR:-/opt/apps/{{APP_NAME}}/__VERSION__}"
APP_DIR="$(dirname "$VERSION_DIR")"
HEALTH_PORT="{{HEALTH_PORT}}"
SERVICE_NAME="{{APP_NAME}}"

echo "========================================"; echo "  {{APP_NAME}} 升级脚本（systemd）"; echo "========================================"
echo "VERSION_DIR: $VERSION_DIR  APP_DIR: $APP_DIR"

[ -d "$VERSION_DIR" ] || { echo "❌ VERSION_DIR 不存在: $VERSION_DIR"; exit 1; }
systemctl --version > /dev/null 2>&1 || { echo "❌ systemd 不可用"; exit 1; }

# 切换软链接：previous → 当前 current 目标
OLD_VERSION_DIR="$(readlink -f "$APP_DIR/current" 2>/dev/null || true)"
if [ -n "$OLD_VERSION_DIR" ] && [ "$OLD_VERSION_DIR" != "$VERSION_DIR" ]; then
    ln -sfn "$OLD_VERSION_DIR" "$APP_DIR/previous"
    echo "previous → $OLD_VERSION_DIR"
fi

# 停止旧服务
systemctl stop "$SERVICE_NAME" || true

# 等待端口释放
is_port_in_use() {
    command -v ss &> /dev/null && ss -ltnH "sport = :${HEALTH_PORT}" 2>/dev/null | grep -q . && return 0
    command -v lsof &> /dev/null && lsof -nP -iTCP:"${HEALTH_PORT}" -sTCP:LISTEN 2>/dev/null | awk 'NR>1' | grep -q . && return 0
    return 1
}
retry=0; while [ $retry -lt 5 ]; do is_port_in_use || break; retry=$((retry+1)); sleep 1; done
is_port_in_use && { echo "❌ 端口 ${HEALTH_PORT} 仍被占用"; exit 1; }

# 安装 unit 文件并 daemon-reload
cp "$VERSION_DIR/config/${SERVICE_NAME}.service" /etc/systemd/system/
systemctl daemon-reload

# 切换 current → 新版本
ln -sfn "$VERSION_DIR" "$APP_DIR/current"
echo "current → $VERSION_DIR"

systemctl enable "$SERVICE_NAME"
systemctl start "$SERVICE_NAME"
sleep 5

HEALTH_URL="http://127.0.0.1:${HEALTH_PORT}/health"
RETRY_COUNT=0
while [ $RETRY_COUNT -lt 10 ]; do
    curl -sf "$HEALTH_URL" > /dev/null 2>&1 && echo "✅ 健康检查通过" && exit 0
    RETRY_COUNT=$((RETRY_COUNT+1)); echo "  尝试 $RETRY_COUNT/10 ..."; sleep 3
done
echo "❌ 健康检查失败"; exit 1
INSTALL_EOF

sed -i.bak "s|__VERSION__|$VERSION|g" "$TEMP_DIR/scripts/install.sh" && rm -f "$TEMP_DIR/scripts/install.sh.bak"
log_info "install.sh 已生成"

# ============================================================================
# Step 7：生成 uninstall.sh
# ============================================================================
log_step "7. 生成 uninstall.sh"

cat > "$TEMP_DIR/scripts/uninstall.sh" <<'UNINSTALL_EOF'
#!/bin/bash
# uninstall.sh - {{APP_NAME}} systemd 卸载脚本
# 编码: UTF-8
set -e

VERSION_DIR="${VERSION_DIR:-/opt/apps/{{APP_NAME}}/__VERSION__}"
APP_DIR="$(dirname "$VERSION_DIR")"
SERVICE_NAME="{{APP_NAME}}"

systemctl stop "$SERVICE_NAME" || true
systemctl disable "$SERVICE_NAME" || true
rm -f "/etc/systemd/system/${SERVICE_NAME}.service"
systemctl daemon-reload

rm -f "$APP_DIR/current" "$APP_DIR/previous"
echo "✅ {{APP_NAME}} 卸载完成（版本目录保留: $VERSION_DIR）"
# 如需删除版本目录，取消注释：
# rm -rf "$VERSION_DIR"
exit 0
UNINSTALL_EOF

sed -i.bak "s|__VERSION__|$VERSION|g" "$TEMP_DIR/scripts/uninstall.sh" && rm -f "$TEMP_DIR/scripts/uninstall.sh.bak"
log_info "uninstall.sh 已生成"

# ============================================================================
# Step 8：生成 rollback.sh
# ============================================================================
log_step "8. 生成 rollback.sh"

cat > "$TEMP_DIR/scripts/rollback.sh" <<'ROLLBACK_EOF'
#!/bin/bash
# rollback.sh - {{APP_NAME}} systemd 回滚脚本
# 编码: UTF-8
set -e

VERSION_DIR="${VERSION_DIR:-/opt/apps/{{APP_NAME}}/__VERSION__}"
APP_DIR="$(dirname "$VERSION_DIR")"
HEALTH_PORT="{{HEALTH_PORT}}"
SERVICE_NAME="{{APP_NAME}}"

ROLLBACK_DIR="$(readlink -f "$APP_DIR/previous" 2>/dev/null || true)"
[ -z "$ROLLBACK_DIR" ] && { echo "❌ previous 软链接不存在，无法回滚"; exit 1; }
[ -f "$ROLLBACK_DIR/bin/${SERVICE_NAME}" ] || { echo "❌ 回滚版本 binary 不存在: $ROLLBACK_DIR/bin/${SERVICE_NAME}"; exit 1; }

systemctl stop "$SERVICE_NAME" || true

is_port_in_use() {
    command -v ss &> /dev/null && ss -ltnH "sport = :${HEALTH_PORT}" 2>/dev/null | grep -q . && return 0
    command -v lsof &> /dev/null && lsof -nP -iTCP:"${HEALTH_PORT}" -sTCP:LISTEN 2>/dev/null | awk 'NR>1' | grep -q . && return 0
    return 1
}
retry=0; while [ $retry -lt 5 ]; do is_port_in_use || break; retry=$((retry+1)); sleep 1; done
is_port_in_use && { echo "❌ 端口 ${HEALTH_PORT} 仍被占用"; exit 1; }

# 切换 current → 回滚版本（不更新 previous）
ln -sfn "$ROLLBACK_DIR" "$APP_DIR/current"
echo "current → $ROLLBACK_DIR"

# 安装回滚版本的 unit 文件
cp "$ROLLBACK_DIR/config/${SERVICE_NAME}.service" /etc/systemd/system/
systemctl daemon-reload
systemctl start "$SERVICE_NAME"
sleep 5

HEALTH_URL="http://127.0.0.1:${HEALTH_PORT}/health"
RETRY_COUNT=0
while [ $RETRY_COUNT -lt 10 ]; do
    curl -sf "$HEALTH_URL" > /dev/null 2>&1 && echo "✅ 回滚成功" && exit 0
    RETRY_COUNT=$((RETRY_COUNT+1)); echo "  尝试 $RETRY_COUNT/10 ..."; sleep 3
done
echo "❌ 健康检查失败"; exit 1
ROLLBACK_EOF

sed -i.bak "s|__VERSION__|$VERSION|g" "$TEMP_DIR/scripts/rollback.sh" && rm -f "$TEMP_DIR/scripts/rollback.sh.bak"
log_info "rollback.sh 已生成"

# ============================================================================
# Step 9：生成 start.sh / stop.sh
# ============================================================================
log_step "9. 生成 start.sh / stop.sh"

cat > "$TEMP_DIR/scripts/start.sh" <<'START_EOF'
#!/bin/bash
# start.sh - {{APP_NAME}} 启动脚本
# 编码: UTF-8
systemctl start {{APP_NAME}}
START_EOF

cat > "$TEMP_DIR/scripts/stop.sh" <<'STOP_EOF'
#!/bin/bash
# stop.sh - {{APP_NAME}} 停止脚本
# 编码: UTF-8
systemctl stop {{APP_NAME}}
STOP_EOF

log_info "start.sh / stop.sh 已生成"

# ============================================================================
# Step 10-15：权限、编码验证、打包、验证、保留
# ============================================================================
log_step "10. 设置文件权限"
chmod 644 "$TEMP_DIR/app.yaml"
chmod +x "$TEMP_DIR/scripts/install.sh" "$TEMP_DIR/scripts/uninstall.sh" \
         "$TEMP_DIR/scripts/rollback.sh" "$TEMP_DIR/scripts/start.sh" "$TEMP_DIR/scripts/stop.sh"
chmod +x "$TEMP_DIR/bin/{{APP_NAME}}"
chmod 644 "$TEMP_DIR/config/{{APP_NAME}}.service"
log_info "文件权限已设置"

log_step "11. 验证文件编码"
for file in "$TEMP_DIR/app.yaml" "$TEMP_DIR/scripts"/*.sh; do
    if ! validate_utf8_file "$file"; then
        log_error "文件编码不是 UTF-8: $file"; show_encoding_diagnostics "$file"; cleanup; exit 1
    fi
done
log_info "所有文件编码验证通过（UTF-8）"

log_step "12. 打包压缩"
cd "$TEMP_DIR"
PACKAGE_FILE="${OUTPUT_DIR}/${PACKAGE_NAME}.tar.gz"
[ -f "$PACKAGE_FILE" ] && rm -f "$PACKAGE_FILE"
tar -czf "$PACKAGE_FILE" .
log_info "压缩包已创建: $PACKAGE_FILE"

log_step "13. 验证压缩包"
REQUIRED_FILES=("./app.yaml" "./scripts/install.sh" "./scripts/uninstall.sh" "./scripts/rollback.sh"
                "./scripts/start.sh" "./scripts/stop.sh" "./bin/{{APP_NAME}}" "./config/{{APP_NAME}}.service")
for f in "${REQUIRED_FILES[@]}"; do
    tar -tzf "$PACKAGE_FILE" | grep -q "^${f}$" || { log_error "压缩包缺少: $f"; cleanup; exit 1; }
done
log_info "压缩包验证通过"

log_step "14. 保留未压缩内容"
cd "$PROJECT_ROOT"
preserve_unpacked

log_step "✅ 打包完成"
echo ""
echo "应用: $APP_NAME  版本: $VERSION  环境: $ENV"
echo "压缩包: $PACKAGE_FILE  ($(du -h "$PACKAGE_FILE" | cut -f1))"
echo "未压缩: $FINAL_DIR"
exit 0
