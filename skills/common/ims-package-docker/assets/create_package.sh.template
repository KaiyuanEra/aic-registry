#!/bin/bash
# create_package.sh - 生成边缘下发应用安装包（Docker Compose 模式）
# 编码: UTF-8
# 生成自 ims-package-docker skill，{{APP_NAME}} 已替换为实际应用名

set -e

# ============================================================================
# 参数读取（从环境变量）
# ============================================================================
APP_NAME="${APP_NAME:-{{APP_NAME}}}"
VERSION="${VERSION:-dev}"
ENV="${ENV:-prod}"
OUTPUT_DIR="${OUTPUT_DIR:-dist/packages}"

# ============================================================================
# 常量定义
# ============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PACKAGE_NAME="${APP_NAME}-${VERSION}"

if [[ "$OUTPUT_DIR" != /* ]]; then
    OUTPUT_DIR="${PROJECT_ROOT}/${OUTPUT_DIR}"
fi

TEMP_DIR="${OUTPUT_DIR}/.tmp/${PACKAGE_NAME}"
FINAL_DIR="${OUTPUT_DIR}/${VERSION}"
DOCKER_COMPOSE_SRC="${PROJECT_ROOT}/docker/docker-edge-compose.yml"
DOCKER_ROLLBACK_COMPOSE_SRC="${PROJECT_ROOT}/docker/docker-rollback-compose.yml"
DIRS_LOG_SRC="${PROJECT_ROOT}/docker/dirs.log"

# ============================================================================
# 函数定义
# ============================================================================
log_info()  { echo "✅ $1"; }
log_error() { echo "❌ 错误: $1" >&2; }
log_step()  { echo ""; echo "===================================="; echo "  $1"; echo "===================================="; }

validate_utf8_file() {
    local file="$1"
    if command -v python3 > /dev/null 2>&1; then
        python3 - "$file" > /dev/null 2>&1 <<'PY'
from pathlib import Path
import sys
Path(sys.argv[1]).read_bytes().decode("utf-8")
PY
        return $?
    fi
    if command -v iconv > /dev/null 2>&1; then
        iconv -f UTF-8 -t UTF-8 "$file" > /dev/null 2>&1; return $?
    fi
    if command -v file > /dev/null 2>&1; then
        file -I "$file" 2>/dev/null | grep -Eq 'charset=(utf-8|us-ascii)$'; return $?
    fi
    return 0
}

show_encoding_diagnostics() {
    local file="$1"
    if command -v file > /dev/null 2>&1; then
        echo "   file -I: $(file -I "$file" 2>/dev/null || echo unavailable)" >&2
    fi
    if command -v iconv > /dev/null 2>&1; then
        iconv -f UTF-8 -t UTF-8 "$file" > /dev/null 2>&1; echo "   iconv exit code: $?" >&2
    fi
}

cleanup() {
    [ -d "$TEMP_DIR" ] && rm -rf "$TEMP_DIR"
}

preserve_unpacked() {
    if [ -d "$TEMP_DIR" ]; then
        [ -d "$FINAL_DIR" ] && rm -rf "$FINAL_DIR"
        mv "$TEMP_DIR" "$FINAL_DIR"
        log_info "未压缩内容已保留: $FINAL_DIR"
    fi
}

extract_compose_value() {
    local compose_file="$1" key="$2"
    sed -n "s/^[[:space:]]*${key}:[[:space:]]*//p" "$compose_file" | head -1 | tr -d '"' | tr -d "'"
}

# ============================================================================
# Step 1：环境检查
# ============================================================================
log_step "1. 环境检查"

for f in "$DOCKER_COMPOSE_SRC" "$DOCKER_ROLLBACK_COMPOSE_SRC" "$DIRS_LOG_SRC"; do
    [ -f "$f" ] || { log_error "必需文件不存在: $f"; exit 1; }
    log_info "已找到: $f"
done

EDGE_IMAGE="$(extract_compose_value "$DOCKER_COMPOSE_SRC" "image")"; [ -z "$EDGE_IMAGE" ] && EDGE_IMAGE="(unknown)"
EDGE_CONTAINER_NAME="$(extract_compose_value "$DOCKER_COMPOSE_SRC" "container_name")"; [ -z "$EDGE_CONTAINER_NAME" ] && EDGE_CONTAINER_NAME="(unknown)"
ROLLBACK_IMAGE="$(extract_compose_value "$DOCKER_ROLLBACK_COMPOSE_SRC" "image")"; [ -z "$ROLLBACK_IMAGE" ] && ROLLBACK_IMAGE="(unknown)"
ROLLBACK_CONTAINER_NAME="$(extract_compose_value "$DOCKER_ROLLBACK_COMPOSE_SRC" "container_name")"; [ -z "$ROLLBACK_CONTAINER_NAME" ] && ROLLBACK_CONTAINER_NAME="(unknown)"

mkdir -p "$OUTPUT_DIR"
cleanup

# ============================================================================
# Step 2：创建目录结构
# ============================================================================
log_step "2. 创建目录结构"
mkdir -p "$TEMP_DIR/scripts" "$TEMP_DIR/config"
log_info "临时目录: $TEMP_DIR"

# ============================================================================
# Step 3：生成 app.yaml
# ============================================================================
log_step "3. 生成 app.yaml"

cat > "$TEMP_DIR/app.yaml" <<'EOF'
name: {{APP_NAME}}
version: "__VERSION__"
description: {{APP_DESCRIPTION}}

ports:
  - {{HEALTH_PORT}}

health_check:
  type: http
  urls:
    - http://127.0.0.1:{{HEALTH_PORT}}/health
  strategy: any
  timeout: 3000
EOF

sed -i.bak "s/__VERSION__/$VERSION/g" "$TEMP_DIR/app.yaml" && rm -f "$TEMP_DIR/app.yaml.bak"
log_info "app.yaml 已生成"

# ============================================================================
# Step 4：生成 install.sh
# ============================================================================
log_step "4. 生成 install.sh"

cat > "$TEMP_DIR/scripts/install.sh" <<'INSTALL_EOF'
#!/bin/bash
# install.sh - {{APP_NAME}} 升级脚本（含首次部署分支）
# 编码: UTF-8
set -e

INSTALL_DIR="${VERSION_DIR:-/opt/apps/{{APP_NAME}}/__VERSION__}"
EDGE_COMPOSE_FILE="docker-edge-compose.yml"
ROLLBACK_COMPOSE_FILE="docker-rollback-compose.yml"
HEALTH_PORT="{{HEALTH_PORT}}"
GRACE_TIMEOUT="${GRACE_TIMEOUT:-20}"

echo "========================================"; echo "  {{APP_NAME}} 升级脚本"; echo "========================================"
echo "安装目录: $INSTALL_DIR  操作: ${OPERATION:-install}"

[ -d "$INSTALL_DIR" ] || { echo "❌ 安装目录不存在: $INSTALL_DIR"; exit 1; }
command -v docker &> /dev/null || { echo "❌ 未安装 Docker"; exit 1; }
{ command -v docker-compose &> /dev/null || docker compose version &> /dev/null; } || { echo "❌ 未安装 Docker Compose"; exit 1; }

# 初始化必需目录
DIRS_CONFIG="$INSTALL_DIR/config/dirs.log"
if [ -f "$DIRS_CONFIG" ]; then
    while IFS= read -r dir_path || [ -n "$dir_path" ]; do
        [[ -z "$dir_path" || "$dir_path" =~ ^[[:space:]]*# ]] && continue
        [ -d "$dir_path" ] || mkdir -p "$dir_path" && echo "  创建目录: $dir_path"
    done < "$DIRS_CONFIG"
fi

cd "$INSTALL_DIR/scripts"
export HOSTNAME="${HOSTNAME:-$(hostname)}"

read_compose_value() { sed -n "s/^[[:space:]]*${2}:[[:space:]]*//p" "$1" | head -1 | tr -d '"' | tr -d "'"; }

[ -f "$EDGE_COMPOSE_FILE" ] || { echo "❌ $EDGE_COMPOSE_FILE 不存在"; exit 1; }
TARGET_CONTAINER="$(read_compose_value "$EDGE_COMPOSE_FILE" "container_name")"
[ -z "$TARGET_CONTAINER" ] && { echo "❌ 无法解析 container_name"; exit 1; }

list_app_containers() { docker container ls -a --format '{{.Names}}' | grep '^{{APP_NAME}}-' || true; }

compose_down_if_exists() {
    [ -f "$1" ] || return 0
    if command -v docker-compose &> /dev/null; then
        docker-compose -f "$1" down --remove-orphans --timeout "$GRACE_TIMEOUT" || true
    else
        docker compose -f "$1" down --remove-orphans --timeout "$GRACE_TIMEOUT" || true
    fi
}

cleanup_single_container() {
    [ -z "$1" ] && return 0
    docker stop --time "$GRACE_TIMEOUT" "$1" > /dev/null 2>&1 || true
    docker rm "$1" > /dev/null 2>&1 || true
    docker container inspect "$1" > /dev/null 2>&1 && docker rm -f "$1" > /dev/null 2>&1 || true
}

cleanup_app_containers() {
    local containers; containers="$(list_app_containers)"
    [ -z "$containers" ] && { echo "ℹ️  无历史容器，按首次部署继续"; return 0; }
    echo "检测到历史容器:"; echo "$containers" | sed 's/^/  - /'
    compose_down_if_exists "$ROLLBACK_COMPOSE_FILE"; compose_down_if_exists "$EDGE_COMPOSE_FILE"
    containers="$(list_app_containers)"
    [ -z "$containers" ] && return 0
    while IFS= read -r c || [ -n "$c" ]; do [ -z "$c" ] && continue; cleanup_single_container "$c"; done <<< "$containers"
}

is_port_in_use() {
    command -v ss &> /dev/null && ss -ltnH "sport = :${HEALTH_PORT}" 2>/dev/null | grep -q . && return 0
    command -v lsof &> /dev/null && lsof -nP -iTCP:"${HEALTH_PORT}" -sTCP:LISTEN 2>/dev/null | awk 'NR>1' | grep -q . && return 0
    docker container ls --filter "status=running" --filter "publish=${HEALTH_PORT}" --format '{{.Names}}' | grep -q . && return 0
    return 1
}

ensure_port_released() {
    local retry=0
    while [ $retry -lt 5 ]; do is_port_in_use || return 0; retry=$((retry+1)); sleep 1; done
    echo "❌ 端口 ${HEALTH_PORT} 仍被占用"; exit 1
}

compose_up() {
    if command -v docker-compose &> /dev/null; then docker-compose -f "$EDGE_COMPOSE_FILE" up -d --remove-orphans
    else docker compose -f "$EDGE_COMPOSE_FILE" up -d --remove-orphans; fi
}

cleanup_app_containers
ensure_port_released
compose_up
sleep 5

HEALTH_URL="http://127.0.0.1:${HEALTH_PORT}/health"
RETRY_COUNT=0
while [ $RETRY_COUNT -lt 10 ]; do
    curl -sf "$HEALTH_URL" > /dev/null 2>&1 && echo "✅ 健康检查通过" && exit 0
    RETRY_COUNT=$((RETRY_COUNT+1)); echo "  尝试 $RETRY_COUNT/10 ..."; sleep 3
done
echo "❌ 健康检查失败"; exit 1
INSTALL_EOF

sed -i.bak "s|__VERSION__|$VERSION|g" "$TEMP_DIR/scripts/install.sh" && rm -f "$TEMP_DIR/scripts/install.sh.bak"
log_info "install.sh 已生成"

# ============================================================================
# Step 5：生成 uninstall.sh
# ============================================================================
log_step "5. 生成 uninstall.sh"

cat > "$TEMP_DIR/scripts/uninstall.sh" <<'UNINSTALL_EOF'
#!/bin/bash
# uninstall.sh - {{APP_NAME}} 卸载脚本
# 编码: UTF-8
set -e

INSTALL_DIR="${VERSION_DIR:-/opt/apps/{{APP_NAME}}/__VERSION__}"
EDGE_COMPOSE_FILE="docker-edge-compose.yml"
ROLLBACK_COMPOSE_FILE="docker-rollback-compose.yml"

[ -d "$INSTALL_DIR/scripts" ] || { echo "⚠️  scripts 目录不存在，跳过"; exit 0; }
cd "$INSTALL_DIR/scripts"

down_by_compose() {
    [ -f "$1" ] || return 0
    if command -v docker-compose &> /dev/null; then docker-compose -f "$1" down --rmi all --volumes || true
    else docker compose -f "$1" down --rmi all --volumes || true; fi
}

down_by_compose "$EDGE_COMPOSE_FILE"
down_by_compose "$ROLLBACK_COMPOSE_FILE"

docker container ls -a --format '{{.Names}}' | grep '^{{APP_NAME}}-' | while read -r c; do
    docker rm -f "$c" > /dev/null 2>&1 || true
done

echo "✅ {{APP_NAME}} 卸载完成（安装目录保留: $INSTALL_DIR）"
# 如需删除安装目录，取消注释：
# rm -rf "$INSTALL_DIR"
exit 0
UNINSTALL_EOF

sed -i.bak "s|__VERSION__|$VERSION|g" "$TEMP_DIR/scripts/uninstall.sh" && rm -f "$TEMP_DIR/scripts/uninstall.sh.bak"
log_info "uninstall.sh 已生成"

# ============================================================================
# Step 6：生成 rollback.sh
# ============================================================================
log_step "6. 生成 rollback.sh"

cat > "$TEMP_DIR/scripts/rollback.sh" <<'ROLLBACK_EOF'
#!/bin/bash
# rollback.sh - {{APP_NAME}} 回滚脚本
# 编码: UTF-8
set -e

INSTALL_DIR="${VERSION_DIR:-/opt/apps/{{APP_NAME}}/__VERSION__}"
EDGE_COMPOSE_FILE="docker-edge-compose.yml"
ROLLBACK_COMPOSE_FILE="docker-rollback-compose.yml"
HEALTH_PORT="{{HEALTH_PORT}}"
GRACE_TIMEOUT="${GRACE_TIMEOUT:-20}"

[ -d "$INSTALL_DIR/scripts" ] || { echo "❌ scripts 目录不存在: $INSTALL_DIR/scripts"; exit 1; }
cd "$INSTALL_DIR/scripts"

compose_down_if_exists() {
    [ -f "$1" ] || return 0
    if command -v docker-compose &> /dev/null; then
        docker-compose -f "$1" down --remove-orphans --timeout "$GRACE_TIMEOUT" || true
    else docker compose -f "$1" down --remove-orphans --timeout "$GRACE_TIMEOUT" || true; fi
}

cleanup_single_container() {
    [ -z "$1" ] && return 0
    docker stop --time "$GRACE_TIMEOUT" "$1" > /dev/null 2>&1 || true
    docker rm "$1" > /dev/null 2>&1 || true
    docker container inspect "$1" > /dev/null 2>&1 && docker rm -f "$1" > /dev/null 2>&1 || true
}

compose_down_if_exists "$EDGE_COMPOSE_FILE"; compose_down_if_exists "$ROLLBACK_COMPOSE_FILE"
docker container ls -a --format '{{.Names}}' | grep '^{{APP_NAME}}-' | while read -r c; do
    cleanup_single_container "$c"
done

is_port_in_use() {
    command -v ss &> /dev/null && ss -ltnH "sport = :${HEALTH_PORT}" 2>/dev/null | grep -q . && return 0
    command -v lsof &> /dev/null && lsof -nP -iTCP:"${HEALTH_PORT}" -sTCP:LISTEN 2>/dev/null | awk 'NR>1' | grep -q . && return 0
    docker container ls --filter "status=running" --filter "publish=${HEALTH_PORT}" --format '{{.Names}}' | grep -q . && return 0
    return 1
}
retry=0; while [ $retry -lt 5 ]; do is_port_in_use || break; retry=$((retry+1)); sleep 1; done
is_port_in_use && { echo "❌ 端口 ${HEALTH_PORT} 仍被占用"; exit 1; }

TARGET_COMPOSE_FILE="$ROLLBACK_COMPOSE_FILE"
[ -f "$TARGET_COMPOSE_FILE" ] || TARGET_COMPOSE_FILE="$EDGE_COMPOSE_FILE"
[ -f "$TARGET_COMPOSE_FILE" ] || { echo "❌ 未找到 compose 配置文件"; exit 1; }

export HOSTNAME="${HOSTNAME:-$(hostname)}"
if command -v docker-compose &> /dev/null; then docker-compose -f "$TARGET_COMPOSE_FILE" up -d --remove-orphans
else docker compose -f "$TARGET_COMPOSE_FILE" up -d --remove-orphans; fi

sleep 5
HEALTH_URL="http://127.0.0.1:${HEALTH_PORT}/health"
RETRY_COUNT=0
while [ $RETRY_COUNT -lt 10 ]; do
    curl -sf "$HEALTH_URL" > /dev/null 2>&1 && echo "✅ 回滚成功" && exit 0
    RETRY_COUNT=$((RETRY_COUNT+1)); echo "  尝试 $RETRY_COUNT/10 ..."; sleep 3
done
echo "❌ 健康检查失败"; exit 1
ROLLBACK_EOF

sed -i.bak "s|__VERSION__|$VERSION|g" "$TEMP_DIR/scripts/rollback.sh" && rm -f "$TEMP_DIR/scripts/rollback.sh.bak"
log_info "rollback.sh 已生成"

# ============================================================================
# Step 7：生成 start.sh
# ============================================================================
log_step "7. 生成 start.sh"

cat > "$TEMP_DIR/scripts/start.sh" <<'START_EOF'
#!/bin/bash
# start.sh - {{APP_NAME}} 启动脚本
# 编码: UTF-8
set -e

INSTALL_DIR="${VERSION_DIR:-/opt/apps/{{APP_NAME}}/__VERSION__}"
EDGE_COMPOSE_FILE="docker-edge-compose.yml"
HEALTH_PORT="{{HEALTH_PORT}}"

[ -d "$INSTALL_DIR/scripts" ] || { echo "❌ scripts 目录不存在"; exit 1; }
command -v docker &> /dev/null || { echo "❌ 未安装 Docker"; exit 1; }
{ command -v docker-compose &> /dev/null || docker compose version &> /dev/null; } || { echo "❌ 未安装 Docker Compose"; exit 1; }

cd "$INSTALL_DIR/scripts"
export HOSTNAME="${HOSTNAME:-$(hostname)}"
[ -f "$EDGE_COMPOSE_FILE" ] || { echo "❌ $EDGE_COMPOSE_FILE 不存在"; exit 1; }

# 端口冲突检测（检测到即退出，不重试）
is_port_in_use() {
    command -v ss &> /dev/null && ss -ltnH "sport = :${HEALTH_PORT}" 2>/dev/null | grep -q . && return 0
    command -v lsof &> /dev/null && lsof -nP -iTCP:"${HEALTH_PORT}" -sTCP:LISTEN 2>/dev/null | awk 'NR>1' | grep -q . && return 0
    docker container ls --filter "status=running" --filter "publish=${HEALTH_PORT}" --format '{{.Names}}' | grep -q . && return 0
    return 1
}
is_port_in_use && { echo "❌ 端口 ${HEALTH_PORT} 已被占用，启动终止"; exit 1; }

if command -v docker-compose &> /dev/null; then docker-compose -f "$EDGE_COMPOSE_FILE" up -d --remove-orphans
else docker compose -f "$EDGE_COMPOSE_FILE" up -d --remove-orphans; fi

sleep 5
RETRY_COUNT=0
while [ $RETRY_COUNT -lt 10 ]; do
    curl -sf "http://127.0.0.1:${HEALTH_PORT}/health" > /dev/null 2>&1 && echo "✅ 启动成功" && exit 0
    RETRY_COUNT=$((RETRY_COUNT+1)); echo "  尝试 $RETRY_COUNT/10 ..."; sleep 3
done
echo "⚠️  健康检查未通过，请手动检查"; exit 0
START_EOF

sed -i.bak "s|__VERSION__|$VERSION|g" "$TEMP_DIR/scripts/start.sh" && rm -f "$TEMP_DIR/scripts/start.sh.bak"
log_info "start.sh 已生成"

# ============================================================================
# Step 8：生成 stop.sh
# ============================================================================
log_step "8. 生成 stop.sh"

cat > "$TEMP_DIR/scripts/stop.sh" <<'STOP_EOF'
#!/bin/bash
# stop.sh - {{APP_NAME}} 停止脚本（保留容器和数据卷）
# 编码: UTF-8
set -e

INSTALL_DIR="${VERSION_DIR:-/opt/apps/{{APP_NAME}}/__VERSION__}"
EDGE_COMPOSE_FILE="docker-edge-compose.yml"
ROLLBACK_COMPOSE_FILE="docker-rollback-compose.yml"

[ -d "$INSTALL_DIR/scripts" ] || { echo "⚠️  scripts 目录不存在，跳过"; exit 0; }
cd "$INSTALL_DIR/scripts"

stop_with_compose() {
    [ -f "$1" ] || return 0
    if command -v docker-compose &> /dev/null; then docker-compose -f "$1" stop || true
    else docker compose -f "$1" stop || true; fi
}

stop_with_compose "$EDGE_COMPOSE_FILE"
stop_with_compose "$ROLLBACK_COMPOSE_FILE"
echo "✅ {{APP_NAME}} 已停止（容器和数据卷已保留）"
exit 0
STOP_EOF

sed -i.bak "s|__VERSION__|$VERSION|g" "$TEMP_DIR/scripts/stop.sh" && rm -f "$TEMP_DIR/scripts/stop.sh.bak"
log_info "stop.sh 已生成"

# ============================================================================
# Step 9：复制 compose 文件和 dirs.log
# ============================================================================
log_step "9. 复制配置文件"
cp "$DOCKER_COMPOSE_SRC" "$TEMP_DIR/scripts/docker-edge-compose.yml"
cp "$DOCKER_ROLLBACK_COMPOSE_SRC" "$TEMP_DIR/scripts/docker-rollback-compose.yml"
cp "$DIRS_LOG_SRC" "$TEMP_DIR/config/dirs.log"
log_info "配置文件已复制"

# ============================================================================
# Step 10：设置文件权限
# ============================================================================
log_step "10. 设置文件权限"
chmod 644 "$TEMP_DIR/app.yaml"
chmod +x "$TEMP_DIR/scripts/install.sh" "$TEMP_DIR/scripts/uninstall.sh" \
         "$TEMP_DIR/scripts/rollback.sh" "$TEMP_DIR/scripts/start.sh" "$TEMP_DIR/scripts/stop.sh"
chmod 644 "$TEMP_DIR/scripts/docker-edge-compose.yml" "$TEMP_DIR/scripts/docker-rollback-compose.yml"
chmod 644 "$TEMP_DIR/config/dirs.log"
log_info "文件权限已设置"

# ============================================================================
# Step 11：UTF-8 编码验证
# ============================================================================
log_step "11. 验证文件编码"
for file in "$TEMP_DIR/app.yaml" "$TEMP_DIR/scripts"/*.sh; do
    if ! validate_utf8_file "$file"; then
        log_error "文件编码不是 UTF-8: $file"; show_encoding_diagnostics "$file"; cleanup; exit 1
    fi
done
log_info "所有文件编码验证通过（UTF-8）"

# ============================================================================
# Step 12：打包压缩
# ============================================================================
log_step "12. 打包压缩"
cd "$TEMP_DIR"
PACKAGE_FILE="${OUTPUT_DIR}/${PACKAGE_NAME}.tar.gz"
[ -f "$PACKAGE_FILE" ] && rm -f "$PACKAGE_FILE"
tar -czf "$PACKAGE_FILE" .
log_info "压缩包已创建: $PACKAGE_FILE"

# ============================================================================
# Step 13：验证压缩包
# ============================================================================
log_step "13. 验证压缩包"
REQUIRED_FILES=("./app.yaml" "./scripts/install.sh" "./scripts/uninstall.sh" "./scripts/rollback.sh"
                "./scripts/start.sh" "./scripts/stop.sh" "./scripts/docker-edge-compose.yml"
                "./scripts/docker-rollback-compose.yml" "./config/dirs.log")
for f in "${REQUIRED_FILES[@]}"; do
    tar -tzf "$PACKAGE_FILE" | grep -q "^${f}$" || { log_error "压缩包缺少: $f"; cleanup; exit 1; }
done
log_info "压缩包验证通过"

# ============================================================================
# Step 14：保留未压缩内容
# ============================================================================
log_step "14. 保留未压缩内容"
cd "$PROJECT_ROOT"
preserve_unpacked

log_step "✅ 打包完成"
echo ""
echo "应用: $APP_NAME  版本: $VERSION  环境: $ENV"
echo "升级镜像: $EDGE_IMAGE ($EDGE_CONTAINER_NAME)"
echo "回滚镜像: $ROLLBACK_IMAGE ($ROLLBACK_CONTAINER_NAME)"
echo "压缩包: $PACKAGE_FILE  ($(du -h "$PACKAGE_FILE" | cut -f1))"
echo "未压缩: $FINAL_DIR"
exit 0
